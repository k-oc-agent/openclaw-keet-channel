{
  "name": "@plak/openclaw-keet-channel",
  "version": "0.1.9",
  "description": "OpenClaw channel plugin for Keet/Holepunch messaging through a local bridge adapter.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/k-oc-agent/openclaw-keet-channel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-oc-agent/openclaw-keet-channel.git"
  },
  "exports": {
    ".": "./dist/src/index.js",
    "./gateway": "./dist/src/gateway.js",
    "./inbound": "./dist/src/inbound.js",
    "./join-diagnostics": "./dist/src/join-diagnostics.js",
    "./poller": "./dist/src/poller.js",
    "./transport": "./dist/src/transport.js"
  },
  "files": [
    "dist",
    "docs/adr",
    "docs/bridge-cli-contract.md",
    "docs/publish-readiness.md",
    "docs/release.md",
    "docs/security",
    "docs/spec",
    "docs/spikes",
    "docs/uat",
    "scripts/keet-cdp-bridge.mjs",
    "scripts/keet-real-uat-harness.mjs",
    "scripts/fake-keet-bridge.mjs",
    "CHANGELOG.md",
    "LICENSE",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/src/index.js"
    ],
    "setupEntry": "./src/setup-entry.ts",
    "runtimeSetupEntry": "./dist/src/setup-entry.js",
    "channel": {
      "id": "keet",
      "label": "Keet",
      "docsPath": "/plugins/community#keet",
      "blurb": "P2P Keet messaging through an OpenClaw channel plugin.",
      "markdownCapable": false
    },
    "install": {
      "minHostVersion": ">=2026.7.1-2",
      "clawhubSpec": "clawhub:@plak/openclaw-keet-channel",
      "npmSpec": "@plak/openclaw-keet-channel@0.1.9"
    },
    "compat": {
      "pluginApi": ">=2026.7.1",
      "minGatewayVersion": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    },
    "release": {
      "publishToClawHub": true
    }
  },
  "dependencies": {
    "playwright-core": "^1.62.1"
  }
}
